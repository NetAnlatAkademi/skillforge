# Normalise line endings so that formatting checks behave identically on Linux and Windows.
* text=auto eol=lf

*.cs        text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.slnx      text eol=lf
*.md        text eol=lf
*.yml       text eol=lf
*.yaml      text eol=lf
*.json      text eol=lf
*.config    text eol=lf
*.editorconfig text eol=lf

# Scripts keep the line endings their interpreter expects.
*.ps1       text eol=crlf
*.cmd       text eol=crlf
*.sh        text eol=lf

# Binary assets
*.png       binary
*.jpg       binary
*.zip       binary
*.pfx       binary

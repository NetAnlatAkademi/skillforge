<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!--
    Repository-local feed configuration.
    <clear /> ignores machine-level and user-level sources so that a restore is reproducible on any
    developer machine and in CI. Central Package Management also requires either a single source or
    explicit source mapping.
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>

  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>

</configuration>

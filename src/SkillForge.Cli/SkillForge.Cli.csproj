<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>skillforge</AssemblyName>
    <RootNamespace>SkillForge.Cli</RootNamespace>
    <Description>SkillForge command line interface.</Description>

    <!-- Distributed as a .NET global tool; see docs/cli-reference.md for the install command. -->
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>skillforge</ToolCommandName>
    <PackageId>SkillForge.Cli</PackageId>
    <IsPackable>true</IsPackable>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageTags>ai-agents;skills;cli;validation;sarif</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="System.CommandLine" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SkillForge.Cli.Tests" />
    <None Include="..\..\README.md" Pack="true" PackagePath="\" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SkillForge.Infrastructure\SkillForge.Infrastructure.csproj" />
    <ProjectReference Include="..\SkillForge.Reporting\SkillForge.Reporting.csproj" />
  </ItemGroup>

</Project>
